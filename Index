  font-size:12px;
  margin:15px 0;
}
footer {
  background:#0d302b;
  color:white;
  padding:30px 0;
  text-align:center;
}
@media(max-width:700px) {
  .tests { grid-template-columns:repeat(2,1fr); }
}
@media(max-width:430px) {
  .tests { grid-template-columns:1fr; }
}
