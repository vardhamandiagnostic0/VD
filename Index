<style>
:root {
  --green:#123d38;
  --green2:#16765e;
  --mint:#e8f4ef;
  --bg:#f5f8f6;
  --ink:#172b27;
  --muted:#6b7b75;
}
* { box-sizing:border-box; }
body {
  margin:0;
  background:var(--bg);
  color:var(--ink);
  font-family:Arial,sans-serif;
}
.wrap { width:min(1120px,94%); margin:auto; }
.topbar {
  background:var(--green);
  color:white;
  padding:12px;
  font-size:13px;
  text-align:center;
}
header {
  background:white;
  padding:17px 0;
  border-bottom:1px solid #ddd;
}
.nav {
  display:flex;
  align-items:center;
  justify-content:space-between;
}
.brand {
  color:var(--green);
  font-size:20px;
  font-weight:bold;
}
.brand small {
  display:block;
  font-size:10px;
  letter-spacing:2px;
}
.btn {
  display:inline-block;
  border:0;
  border-radius:10px;
  padding:12px 17px;
  font-weight:bold;
  text-decoration:none;
  cursor:pointer;
}
.primary { background:var(--green2); color:white; }
.hero {
  background:linear-gradient(120deg,#123d38,#176b55);
  color:white;
  padding:55px 0;
}
.hero h1 {
  font-size:clamp(35px,6vw,55px);
  margin:12px 0;
}
.hero p {
  line-height:1.7;
  color:#e0eee8;
}
.hero-card {
  background:white;
  color:var(--ink);
  padding:23px;
  border-radius:18px;
  margin-top:25px;
}
section { padding:40px 0; }
h2 { color:var(--green); }
input,select,textarea {
  width:100%;
  padding:13px;
  border:1px solid #dce6e0;
  border-radius:10px;
  margin:5px 0 12px;
  font:inherit;
}
.filters {
  display:flex;
  flex-wrap:wrap;
  gap:8px;
  margin:15px 0;
}
.chip {
  background:white;
  border:1px solid #ddd;
  border-radius:25px;
  padding:9px 14px;
  cursor:pointer;
}
.chip.active {
  background:var(--green);
  color:white;
}
.tests {
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:13px;
}
.test {
  background:white;
  padding:16px;
  border:1px solid #e3ebe7;
  border-radius:14px;
}
.test h3 { font-size:15px; }
.price { color:var(--green); font-weight:bold; }
.add {
  background:var(--green2);
  color:white;
  border:0;
  border-radius:8px;
  padding:9px 12px;
  cursor:pointer;
}
.panel {
  background:white;
  border-radius:15px;
  padding:20px;
  margin-bottom:18px;
}
.cart-row {
  display:flex;
  justify-content:space-between;
  padding:12px 0;
  border-bottom:1px solid #eee;
  gap:10px;
}
.total {
  display:flex;
  justify-content:space-between;
  font-weight:bold;
  margin-top:15px;
}
.notice {
  background:#fff8e8;
  padding:12px;
  border-radius:10px;
  font-size:12px;
  margin:15px 0;
}
footer {
  background:#0d302b;
  color:white;
  padding:30px 0;
  text-align:center;
}
@media(max-width:700px) {
  .tests { grid-template-columns:repeat(2,1fr); }
}
@media(max-width:430px) {
  .tests { grid-template-columns:1fr; }
}
</style>
</head>

