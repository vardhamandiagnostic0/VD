  border:0;
  border-radius:8px;
  padding:9px 12px;
  cursor:pointer;
}
.panel {
  background:white;
  border-radius:15px;
  padding:20px;
  margin-bottom:18px;
}
.cart-row {
  display:flex;
  justify-content:space-between;
  padding:12px 0;
  border-bottom:1px solid #eee;
  gap:10px;
}
.total {
  display:flex;
  justify-content:space-between;
  font-weight:bold;
  margin-top:15px;
}
.notice {
  background:#fff8e8;
  padding:12px;
